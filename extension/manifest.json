{
  "manifest_version": 3,
  "name": "context",
  "version": "0.7",
  "description": "reads slack, google drive and x, and the sites you add, in the background, for the context app on this mac. read only. what it reads goes to the context app on this mac and nowhere else.",
  "key": "",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "nativeMessaging",
    "scripting",
    "alarms",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://app.slack.com/*",
    "https://drive.google.com/*",
    "https://docs.google.com/*",
    "https://x.com/*"
  ],
  "action": {
    "default_title": "context",
    "default_popup": "popup.html"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
