# telegram full export: my.telegram.org > API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# apple mail: your own addresses, only if it cannot tell them from the sent folder
# CTX_MY_EMAILS=you@example.com,you@work.example
# model calls use your signed-in claude or codex cli. force one with: CTX_MODEL=claude | codex | api
# ANTHROPIC_API_KEY=   (only for unattended runs, billed per token. used by the engine's own api call only, never handed to the claude cli)
